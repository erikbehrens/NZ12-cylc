#!jinja2
{% macro format_final(run_periods, fmt='PT1S') -%}
    {%- set ENDYR = '+P%dY'%(run_periods[0]) if run_periods[0] > 0 else '' -%}
    {%- set ENDMO = '+P%dM'%(run_periods[1]) if run_periods[1] > 0 else '' -%}
    {%- set ENDDA = '+P%dD'%(run_periods[2]) if run_periods[2] > 0 else '' -%}
    {%- set ENDHR = '+PT%dH'%(run_periods[3]) if run_periods[3] > 0 else '' -%}
    {%- set ENDMI = '+PT%dM'%(run_periods[4]) if run_periods[4] > 0 else '' -%}
    {{ENDYR}}{{ENDMO}}{{ENDDA}}{{ENDHR}}{{ENDMI}}-{{fmt}}
{%- endmacro %}

{% if BASIS[0] == 0 %}
    {% set CYCLE_INIT = '00000101' %}
{% else %}
    {% set CYCLE_INIT = '%04d%02d%02dT%02d%02d' % (BASIS[0],BASIS[1],BASIS[2],BASIS[3],BASIS[4]) %}
{% endif %}
{% set FMT = 'P' + ('T' if CYCLE == 'm' or CYCLE == 'H' else '') + RESUB|string + CYCLE|upper %}
{% set CYCLE_NRUN = FMT %}
{% set RESUB_LRUN = RESUB*2|int %}
{% set CYCLE_TIMESTEPS = RESUB*TIMESTEPS_PER_DAY|int %}
{% set SECONDS_PER_TIMESTEP = 86400/TIMESTEPS_PER_DAY|float %}
{% set CYCLE_LRUN = 'P' + ('T' if CYCLE == 'm' or CYCLE == 'H' else '') + RESUB_LRUN|string + CYCLE|upper %}

{% set AGRIF = AGRIF if AGRIF is defined else False %}
{% set WRKID = CYLC_WORKFLOW_ID.split("/")[-2][2::] %}
{% if AGRIF %}
   {% set n_zooms = NUM_ZOOMS if NUM_ZOOMS is defined else 0 %}
{% else %}
   {% set n_zooms = 0 %}
{% endif %}
{% set ns = namespace(id_list = WRKID) %}
{% for nn in range(n_zooms) %}
   {% set ZOOM =  ( (nn+1) ~ "_" ~ WRKID ) %}
   {% set ID_LIST = ns.id_list if ns.id_list is defined else WRKID %}
   {% set ns.id_list = (ID_LIST ~ ", " ~ ZOOM) %}
{% endfor %}

[scheduler]
    UTC mode = True

[task parameters]
    domain = {{ ns.id_list }}

[scheduling]
    cycling mode        = {{CALENDAR}}
    initial cycle point = {{CYCLE_INIT}}
    final cycle point = {{ format_final(RUNLEN, FMT) if RUN else CYCLE_INIT }}
    [[ graph ]]
        R1 = """
{% if POSTPROC_SPLIT_ARCHIVE %}
{{ 'hpc_init => fcm_make_pp => fcm_build_pp' + (' => postproc_transform<domain>') if POSTPROC else '' }}
{% else %}
{{ 'hpc_init => fcm_make_pp => fcm_build_pp' + (' => postproc<domain>') if POSTPROC else '' }}
{% endif %}
{{ 'fcm_git_path => fcm_make_ocean => fcm_build_conv => fcm_preproc_agrif => fcm_build_nemo-agrif' + (' => ocean_ice' if RUN else '') if BUILD_OCEAN else '' }}
{{ 'fcm_make_drivers => fcm_build_drivers' + (' => ocean_ice' if RUN else '') if BUILD_DRIVERS else '' }}
    """
    [[ graph ]]
        {{FMT}} = """
{% if RUN %}
    ocean_ice[-{{FMT}}] => ocean_ice {{ '=> \\' if POSTPROC or HOUSEKEEP else '' }}
    {% if POSTPROC %}
       {% if POSTPROC_SPLIT_ARCHIVE %}
 	       postproc_transform<domain> => postproc_archive<domain> {{ '=> \\' if HOUSEKEEP else '' }}
 	   {% else %}
           postproc<domain> {{ '=> \\' if HOUSEKEEP else '' }}
       {% endif %}
    {% endif %}
    {% if HOUSEKEEP %}
        housekeeping
    {% endif %}
    {% if POSTPROC %}
        {% if POSTPROC_SPLIT_ARCHIVE %}
            postproc_archive<domain>[-{{FMT}}] => postproc_transform<domain>
 	    {% else %}
            postproc<domain>[-{{FMT}}] => postproc<domain>
        {% endif %}
    {% endif %}
{% endif %}
    """

{% include 'restart_graph.rc' %}

[runtime]
    [[root]]
        init-script = """
        export CYLC_VERSION={{CYLC_VERSION}}
        export ROSE_VERSION={{ROSE_VERSION}}
        """
        script = "rose task-run --verbose"
        env-script = "eval $(rose task-env)"
        [[[environment]]]
            MODELBASIS = '{{BASIS[0]}},{{BASIS[1]}},{{BASIS[2]}},{{BASIS[3]}},0,0'
            CALENDAR   = {{CALENDAR}}
            {% if ( RESUB|string  + CYCLE == '10D' )  %}
                DIAG_MEAN_PERIOD = '10D'
            {% elif ( CYCLE == 'M' ) or ( CYCLE == 'Y' ) %}
                DIAG_MEAN_PERIOD = '1M'
            {% elif ( CYCLE == 'D' ) %}
                DIAG_MEAN_PERIOD = '1D'
            {% else %}
                DIAG_MEAN_PERIOD = 'INVALID_PERIOD'
            {% endif %}
            SECONDS_PER_TIMESTEP = {{SECONDS_PER_TIMESTEP}}

            # Set up the runid which controls the first five characters of the output filenames.
            # This can either be the final five characters of the suite id or RUNID_USR as set
            # by the user.
            {% if RUNID %}
                RUNID = `echo -n $CYLC_WORKFLOW_ID | cut -d - -f 1-3`
            {% else %}
                RUNID = {{ RUNID_USR }}
            {% endif %}

            DATAM      = $CYLC_WORKFLOW_SHARE_DIR/data/{{DATAM}}
            NEMO_DATA  = $CYLC_WORKFLOW_SHARE_DIR/data/{{NEMO_RST}}
            NEMO_RST   = $NEMO_DATA/
            {% if not NEMO_LAND_SUPPRESS %}
                {% set NEMO_NPROC = NEMO_IPROC*NEMO_JPROC %}
            {% endif %}
            NEMO_IPROC = {{NEMO_IPROC}}
            NEMO_JPROC = {{NEMO_JPROC}}
            NEMO_NPROC = {{NEMO_NPROC}}
            XIOS_NPROC = {{XIOS_NPROC}}

            # Needed to avoid MPI errors with Cray cpe 23.05- 
            # buffer required seems to scale with number of XIOS servers.
            FI_CXI_RX_MATCH_MODE = software
            FI_CXI_REQ_BUF_SIZE = {{12582912 * 2}}

        [[[events]]]
            submission timeout = P1D

    [[LINUX_UM]]
        platform = localhost
    [[HPC_UM]]
            platform=cascade-pbs
        [[[directives]]]
           -A = niwa02764
           -koed =

    [[HPC_SERIAL]]
        inherit = None, HPC_UM
        execution time limit = PT10M
        [[[environment]]]
            ROSE_TASK_N_JOBS = 1
        [[[directives]]]
            -l ncpus = 1
            -q = shared
    [[HPC_SERIAL_MASSQ]]
        inherit = HPC_SERIAL
        [[[directives]]]
            -q = mass

    [[hpc_init]]
        platform = {{ COMPUTE_HOST }}
        script = true

    [[fcm_build_ocean]]
        [[[environment]]]
            AGRIF = {{ AGRIF }}
            FCM_MAKE_NEMO_APP = ${CYLC_WORKFLOW_RUN_DIR}/app/fcm_make_ocean
            FCM_MAKE_NEMO_RUN = ${CYLC_WORKFLOW_SHARE_DIR}/fcm_make_ocean
            NEMOCFG           = ${CYLC_WORKFLOW_RUN_DIR}/app/fcm_make_ocean/rose-app.conf
            CPP_CFG           = ${CYLC_WORKFLOW_RUN_DIR}/app/fcm_make_ocean/file/cpp.cfg
            ROSE_TASK_N_JOBS  = 1
    [[fcm_git_path]]
        inherit = fcm_build_ocean,LINUX_UM
        pre-script = "set +u; conda activate CAS; set -u" #CEB
        [[[environment]]]
            SOURCES_NAME=nemo_sources
            PROJECT_NAME=nemo_project_location
            BASE_NAME=nemo_base
            REVISION_NAME=nemo_rev
            CONF_IN=${FCM_MAKE_NEMO_APP}/rose-app.conf
            CONF_OUT=${FCM_MAKE_NEMO_APP}/opt/rose-app-gitpaths.conf
    [[fcm_make_ocean]]
        inherit = None, LINUX_UM
        pre-script = """. /home/behrense/_niwa02764/spack_xios/spack/share/spack/setup-env.sh;
                     ulimit;
                     spack load fcm;
                     spack load intel-oneapi-mpi@2021.16.1 %intel@2021.10.0 /6w64msv;
                     export xios_path=$(spack location -i xios@3.0-2734 %intel@2021.10.0 /ttihzzg);
                     export NETCDF_DIR=$(spack location -i netcdf-fortran@4.6.1 %intel@2021.10.0 /fyycy4j);
                     export NETCDF_DIR2=$(spack location -i netcdf-c@4.9.2 %intel@2021.10.0 /ifaw3jg);
                     export HDF5_DIR=$(spack location -i /nre2tys) """

        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = (gitpaths)
    [[fcm_make2_ocean]]
        inherit = fcm_build_ocean, HPC_UM
        [[[environment]]]
    [[fcm_build_conv]]
        inherit = fcm_build_ocean, LINUX_UM
    [[fcm_preproc_agrif]]
        inherit = fcm_build_ocean, LINUX_UM
        {% if AGRIF %}
           pre-script='''
                      sed -i "s/keys_nemo_app=.*/& key_agrif/g" ${NEMOCFG}
                      keys="$( grep keys ${NEMOCFG} | sed -e 's#keys_nemo_app=##' )"
                      echo "bld::tool::fppkeys   ${keys}" > ${CPP_CFG}
                        '''
        {% else %}
           pre-script='''
                      keys="$( grep keys ${NEMOCFG} | sed -e 's#keys_nemo_app=##' )"
                      echo "bld::tool::fppkeys   ${keys}" > ${CPP_CFG}
                      '''
        {% endif %}
    [[fcm_build_nemo-agrif]]
        inherit = fcm_build_ocean, LINUX_UM
        platform = cascade-pbs
        pre-script = """. /home/behrense/_niwa02764/spack_xios/spack/share/spack/setup-env.sh; ulimit;
                     spack load intel-oneapi-mpi@2021.16.1 %intel@2021.10.0 /6w64msv; 
                     export xios_path=$(spack location -i xios@3.0-2734 %intel@2021.10.0 /ttihzzg);
                     export NETCDF_DIR=$(spack location -i netcdf-fortran@4.6.1 %intel@2021.10.0 /fyycy4j);
                     export NETCDF_DIR2=$(spack location -i netcdf-c@4.9.2 %intel@2021.10.0 /ifaw3jg);
                     export HDF5_DIR=$(spack location -i /nre2tys) """
        [[[directives]]]
        -A = niwa02764
        -q =shortq
        -l select = 1:ncpus=20:mem=32gb
        -l walltime = 02:00:00
        -koed =
        [[[environment]]]
            ROSE_TASK_N_JOBS  =20 

    [[fcm_make_drivers]]
        inherit = None, LINUX_UM
        pre-script = """. /home/behrense/_niwa02764/spack_xios/spack/share/spack/setup-env.sh;
                     ulimit;
                     spack load fcm;"""

     [[fcm_build_drivers]]
        inherit = None, LINUX_UM
        pre-script = """. /home/behrense/_niwa02764/spack_xios/spack/share/spack/setup-env.sh;
                     ulimit;
                     spack load fcm;"""
        script = """
            cd "${CYLC_SUITE_RUN_DIR}/share/fcm_make_drivers"
            cp mirror/* .
            fcm make -f fcm-make.cfg -j 2
            cp "${CYLC_WORKFLOW_RUN_DIR}/local_drivers/Coupled_Drivers/nemo_driver.py" build/bin/nemo_driver.py
            """
    
    [[fcm_make_pp]]
        inherit = None, LINUX_UM
        [[[environment]]]
        ROSE_TASK_MIRROR_TARGET="${CYLC_SUITE_RUN_DIR}/share/fcm_make_pp"
    [[fcm_build_pp]]
        inherit = None, LINUX_UM
        pre-script = "set +u; conda activate CAS; set -u"
        script = """
            cd "${CYLC_SUITE_RUN_DIR}/share/fcm_make_pp"
            fcm make -f fcm-make.cfg -j 2 """

    [[OCEAN_ICE]]
        pre-script = """
                       . {{ANCIL_VERSIONS_OCEAN}}; export HDF5_DISABLE_VERSION_CHECK=1; export HDF5_USE_FILE_LOCKING=FALSE; 
                       chmod +x  $CYLC_SUITE_SHARE_DIR/fcm_make_drivers/build/bin/run_model; export OMP_NUM_THREADS=1;
                       . /home/behrense/_niwa02764/spack_xios/spack/share/spack/setup-env.sh; ulimit;
                     spack load intel-oneapi-mpi@2021.16.1 %intel@2021.10.0 /6w64msv;
                     export LD_LIBRARY_PATH=/esi/project/niwa02764/spack_xios/spack/opt/spack/linux-rocky9-x86_64_v3/intel-2021.10.0/netcdf-c-4.9.2-ifaw3jge5sl4lmkglurchjw56qil6i7t/lib:/esi/project/niwa02764/spack_xios/spack/opt/spack/linux-rocky9-x86_64_v3/intel-2021.10.0/netcdf-fortran-4.6.1-fyycy4j432wh574tdeqjwxahsa7fzkaz/lib:/esi/project/niwa02764/spack_xios/spack/opt/spack/linux-rocky9-x86_64_v3/intel-2021.10.0/hdf5-1.14.5-nre2tysejsmwruznthmjkmvi67s4md3m/lib:/esi/project/niwa02764/spack_xios/spack/opt/spack/linux-rocky9-x86_64_v3/intel-2021.10.0/xios-3.0-2734-ttihzzgoks5vidrjdvtdidyf3figenij/lib:/lib:$LD_LIBRARY_PATH
                      spack find --loaded"""

        inherit = None, HPC_UM
        [[[environment]]]
            ROSE_TASK_APP = ocean_ice
            NUM_ZOOMS = {{NUM_ZOOMS}}
            AGRIF={{ AGRIF }}
            {% if AGRIF %}
               {% set ns  = namespace(app_opt = "agrif") %}
               {% set nss = namespace(agrifdm = "") %}
               {% for nn in range(NUM_ZOOMS) %}
                  {% set ZOOM =  ("agrif_" ~ (nn+1)) %}
                  {% set APP_OPT_T =  ns.app_opt if ns.app_opt is defined else "agrif" %}
                  {% set AGRIF_DOM = nss.agrifdm if nss.agrifdm is defined else "" %}
                  {% set  ns.app_opt = (APP_OPT_T ~ " " ~ ZOOM) %}
                  {% set nss.agrifdm = (AGRIF_DOM ~ " " ~ (nn+1)) %}
               {% endfor %}
               ROSE_APP_OPT_CONF_KEYS={{OCEAN_ICE_OPT_KEYS}} {{ns.app_opt}}
               AGRIF_DOMAINS = {{ nss.agrifdm }}
            {% else %}
               ROSE_APP_OPT_CONF_KEYS={{OCEAN_ICE_OPT_KEYS}} "no-agrif"
               AGRIF_DOMAINS = ""
            {% endif %}
            CONTINUE      = $( \
            if [[ $CYLC_TASK_CYCLE_POINT == $CYLC_WORKFLOW_INITIAL_CYCLE_POINT ]] && \
    [[ $CYLC_TASK_TRY_NUMBER -eq 1 ]]; then echo ""; else echo "true"; fi )
            TASKEND       = $( ROSE_CYCLING_MODE={{CALENDAR}}   isodatetime $CYLC_WORKFLOW_INITIAL_CYCLE_POINT \
            $CYLC_TASK_CYCLE_POINT --offset -{{FMT}} --print-format y,m,d,h,M,s )
            TASKSTART     = $(  isodatetime $CYLC_TASK_CYCLE_POINT --print-format %Y,%m,%d,%H,%M )
            TASKLENGTH    = $( ROSE_CYCLING_MODE={{CALENDAR}}  isodatetime $CYLC_TASK_CYCLE_POINT \
            $CYLC_TASK_CYCLE_POINT -s {{FMT}} -f y,m,d,h,M,s )
            OMP_NUM_THREADS = 1
            ROSE_LAUNCHER = mpiexec
            #ROSE_LAUNCHER_PREOPTS_NEMO = --cpu-bind=depth -n {{NEMO_NPROC}} -ppn {{NEMO_NPROCPERNODE}} -d 1
            #ROSE_LAUNCHER_PREOPTS_XIOS = -n {{XIOS_NPROC}} -ppn {{XIOS_NPROCPERNODE}} -d 1
            #ROSE_LAUNCHER_PREOPTS_NEMO = -n {{NEMO_NPROC}} -ppn {{NEMO_NPROCPERNODE}} \
            #                             --cpu-bind=list:$(bind_list.py {{NEMO_NPROCPERNODE}} 128)
            #ROSE_LAUNCHER_PREOPTS_XIOS = -n {{XIOS_NPROC}} -ppn {{XIOS_NPROCPERNODE}} \
            #                             --cpu-bind=list:$(bind_list.py {{XIOS_NPROCPERNODE}} 128)
            ROSE_LAUNCHER_PREOPTS_NEMO = -n {{NEMO_NPROC}}
            ROSE_LAUNCHER_PREOPTS_XIOS = -n {{XIOS_NPROC}}
            XIOS_EXEC = {{XIOS_EXEC}}
            PREVIOUS_CYCLE =
            NEMO_RESTART_MULTI =
            NEMO_START=
            ICEBERG_RESTART_MULTI=
            NEMO_ICEBERG_START=
            NEMO_ICEBERGS_START=
            SI3_RESTART_MULTI =
            SI3_START =


    [[OCEAN_ICE_RESOURCE]]
            execution time limit = PT{{'%02d' % (CLOCK[0])}}H{{'%02d' % (CLOCK[1])}}M{{'%02d' % (CLOCK[2])}}S
        [[[directives]]]
            -q           = {{HPC_QUEUE}}
            {% set OCEAN_NODES = ((NEMO_NPROC/NEMO_NPROCPERNODE)|round(0,"ceil")|int) %}
            {% set XIOS_NODES  = ((XIOS_NPROC/XIOS_NPROCPERNODE)|round(0,"ceil")|int) %}
            {% set TOT_NODES  = ((OCEAN_NODES+XIOS_NODES)|round(0,"ceil")|int) %}
            -A=niwa02764
            -koed =
            -l walltime=2:00:00
            -q=shortq
            -l select=4:ncpus=384:mem=600gb:ompthreads=1 
    [[ocean_ice]]
        inherit = OCEAN_ICE, OCEAN_ICE_RESOURCE


    [[postproc<domain>]]
        inherit = None, HPC_SERIAL
        pre-script = "module load scitools/production-os46-3; module load um_tools; \
	                  module load nco/5.0.6; module load moose-client ; module list"
        execution retry delays = PT10M, PT1H, PT3H, P1D
        execution time limit = PT2H
        [[[environment]]]
            ROSE_TASK_N_JOBS = 1
{% if USE_CUSTOM_ARCHIVE_NAME %}
            ARCHIVE_SET = {{CUSTOM_ARCHIVE_NAME}}
{% else %}
            ARCHIVE_SET = ${CYLC_WORKFLOW_NAME_BASE}
{% endif %}
            CYCLEPERIOD = {{FMT}}
            PREFIX=${CYLC_TASK_PARAM_domain}
            ROSE_TASK_APP = postproc 

    [[postproc_transform<domain>]]
 	    inherit = postproc<domain>, HPC_SERIAL
 	    [[[environment]]]
 	        ROSE_APP_OPT_CONF_KEYS = transform
 	    [[[directives]]]
            -l mem = 30gb

    [[postproc_archive<domain>]]
 	    inherit = postproc<domain>, HPC_SERIAL_MASSQ
 	    [[[environment]]]
 		    ROSE_APP_OPT_CONF_KEYS = archive


{% include 'restart_runtime.rc' %}

    [[housekeeping]]
        platform = localhost
